<!-- views/home/main.ejs -->
<div class="background-overlay"></div>
<!-- Hero Section -->
<%- include('_hero') %>

<!-- About Section -->
<%- include('_about') %>

<!-- Services Section -->
<%- include('_services') %>

<!-- Portfolio Section -->
<%- include('_portfolio') %>

<!-- Contact Section -->
<%- include('_contact') %>

<!-- MODALS -->
<%
  const modal = (flash?.modal && flash.modal[0]) || null;
%>
<!-- Modal State (read by JS) -->
<div
  id="authModalState"
  data-modal="<%= modal || '' %>"
  data-default-tab="<%= modal || 'login' %>"
></div>


  <!-- Guest -->
<% if (!user) { %>
  <%- include('../modals/auth/_authTabs', { modal }) %>
<% } %>
<% if (modal === 'completeSignup_local' || modal === 'completeSignup_oauth') {
 %>
  <%- include('../modals/auth/_completeSignup', { modal }) %>
<% } %>

