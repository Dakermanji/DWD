<!-- views/modals/auth/_completeSignup_oauth.ejs -->
<div class="mb-3">
	<label for="username" class="form-label"
		><%= t('auth:security.choose_username') %></label
	>
	<input
		type="text"
		class="form-control"
		id="username"
		name="username"
		autocomplete="username"
		required
	/>
</div>

<div class="d-grid">
	<button type="submit" class="btn btn-primary">
		<i class="bi bi-check2-circle me-1"></i> <%= t('save_and_continue') %>
	</button>
</div>
